{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing basic identity information, notification token, and optional anchor times.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" },
        "notificationToken": { "type": "string" },
        "anchorTimes": {
          "type": "object",
          "properties": {
            "beforeWork": { "type": "string" },
            "afterWork": { "type": "string" },
            "beforeSleep": { "type": "string" }
          }
        }
      },
      "required": ["email", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Task created by extraction or manual input with inferred consequence type and reminder tracking timestamps.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "dueAt": { "type": "string", "format": "date-time" },
        "anchorPhrase": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "met", "missed", "released"] },
        "consequenceType": { "type": "string", "enum": ["hard", "soft", "unspecified"] },
        "patternNote": { "type": "string" },
        "lastGuaranteedNudgeAt": { "type": "string", "format": "date-time" },
        "lastEscalationNudgeAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "dueAt", "status", "consequenceType", "createdAt"]
    },
    "TaskEntry": {
      "title": "TaskEntry",
      "description": "Subcollection under a task storing a completed check-in's structured extraction and transcript.",
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "nextPhysicalAction": { "type": "string" },
        "conversation": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["summary", "nextPhysicalAction", "conversation", "createdAt"]
    },
    "LogEntry": {
      "title": "LogEntry",
      "description": "Log entry of completed activities feeding daily strip and fuzzy matching.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "matchedTaskId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "createdAt"]
    },
    "DailyStrip": {
      "title": "DailyStrip",
      "description": "Short descriptive one-line summary of activities for a given day.",
      "type": "object",
      "properties": {
        "line": { "type": "string" }
      },
      "required": ["line"]
    },
    "ThreadMessage": {
      "title": "ThreadMessage",
      "description": "Backing message in the instant-messenger chat thread.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "system"] },
        "text": { "type": "string" },
        "relatedTaskId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "text", "createdAt"]
    },
    "PartnerInvite": {
      "title": "PartnerInvite",
      "description": "Single pinned document tracking pending or active accountability partner invitation.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["pending", "active", "revoked"] },
        "partnerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Root user documents containing profile, notificationToken, and anchorTimes."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks created via extraction with consequence classification."
    },
    "/users/{userId}/tasks/{taskId}/entries/{entryId}": {
      "schema": "TaskEntry",
      "description": "Completed check-in structured summaries on a specific task."
    },
    "/users/{userId}/logEntries/{logEntryId}": {
      "schema": "LogEntry",
      "description": "User log entries describing done activities."
    },
    "/users/{userId}/dailyStrip/{dateId}": {
      "schema": "DailyStrip",
      "description": "Daily one-line narrative summaries."
    },
    "/users/{userId}/threadMessages/{messageId}": {
      "schema": "ThreadMessage",
      "description": "Persistent instant-messenger chat thread messages."
    },
    "/users/{userId}/partnerInvite/{inviteDoc}": {
      "schema": "PartnerInvite",
      "description": "Single pinned document for accountability partner invite."
    }
  }
}
